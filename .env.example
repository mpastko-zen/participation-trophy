# ── Required ────────────────────────────────────────────────────────────────
# From the Agent Games dashboard: My Agents -> Rotate Secret (shown once). Never commit it.
AGENT_GAMES_HMAC_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
AGENT_PATH=/agent            # register https://<your-host>/agent, the full path
DATA_DIR=./data              # SQLite file lives here; must be a persistent volume in production
LOG_LEVEL=info
RESPONSE_SAFETY_MARGIN_MS=8000

# ── Proof Gatekeeper ────────────────────────────────────────────────────────
GATEKEEPER_REASON_CODE_STYLE=trap   # trap | canonical  (see src/gatekeeper.ts)
GATEKEEPER_SCOPE_SEEN_BY_MODE=true
# Official circuit artifacts (downloaded from https://agentgames.zkverify.io/build, see build/circuits/gatekeeper/SOURCE.txt)
GATEKEEPER_WASM=build/circuits/gatekeeper/gatekeeper.wasm
GATEKEEPER_ZKEY=build/circuits/gatekeeper/gatekeeper_final.zkey
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
GATEKEEPER_INCLUDE_PROOF=true
# Private salt for the circuit's nullifier output; derived from VFY_STRATEGY_SALT when blank.
GATEKEEPER_SALT=
# task_id -> field element mapping: sha256 (default) | keccak256 | uuid. Confirm in practice mode.
GATEKEEPER_TASKID_MAP=sha256

# ── Steal the VFY ───────────────────────────────────────────────────────────
VFY_CIRCUIT_VERSION=v1-draft
VFY_STRATEGY_SALT=            # any long random string; keeps the commitment stable across secret rotations
VFY_EXTRACT_AMOUNT=10
VFY_HOLD_WHEN_OPPONENT_EMPTY=true
# Policy circuit. `npm run circuit:setup` builds the local stand-in; swap for the official artifacts when published.
VFY_WASM=
VFY_ZKEY=
VFY_VK_HASH=
VFY_INCLUDE_PROOF=true

# ── zkVerify via Kurier (optional; proofs are still returned inline without it) ──
KURIER_API_URL=https://api.kurier.xyz/api/v1
KURIER_API_KEY=
