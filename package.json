{
  "name": "participation-trophy",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Games (agentgames.zkverify.io) competitor: Proof Gatekeeper + Steal the VFY",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "LOG_LEVEL=error tsx --test test/*.test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "commitment": "tsx scripts/commitment.ts",
    "circuit:reconstruct": "bash scripts/reconstruct-vfy-circuit.sh",
    "kurier:register-vk": "tsx scripts/kurier-register-vk.ts"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "dotenv": "^18.0.8",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.5",
    "circomlib": "^2.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
